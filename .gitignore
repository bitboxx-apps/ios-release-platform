# IDE
.idea/
*.iml
*.xcuserdata/
*.xcworkspace/xcuserdata/

# Spec (kept locally, not tracked). Root only: git on macOS ignores case, so a bare
# "SPEC.md" would also hide every openspec/**/spec.md
/SPEC.md

# macOS
.DS_Store
*.swp
*~

# Environment (secrets)
.env.platform
# NOTE: .env.app is committed (contains no secrets — only app identity like APP_NAME, APP_BUNDLE_ID)
.env.local

# Signing keys
*.p8
*.p12
*.cer
*.mobileprovision

# Ruby
vendor/bundle/
.bundle/
Gemfile.lock

# Fastlane
release/ios/platform/fastlane/report.xml
release/ios/platform/fastlane/README.md
release/ios/platform/fastlane/screenshots/
release/ios/platform/fastlane/test_output/

# Build artifacts
build/
DerivedData/
*.ipa
*.dSYM.zip
*.dSYM

# Xcode
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3
xcuserdata/
*.moved-aside
*.hmap
*.ipa
*.xccheckout
*.xcscmblueprint

# Obsidian (docs/ is a vault): keep shared settings, ignore per-user window state
docs/.obsidian/workspace*.json
docs/.obsidian/cache
